# Connection details for the marimo-demo-pg service (Aiven for PostgreSQL,
# project: hevans-demo). Get the real password from the Aiven Console:
# Services -> marimo-demo-pg -> Overview -> Connection information,
# or `avn service get marimo-demo-pg --project hevans-demo -v` with the CLI.
#
# Copy this file to .env and fill in PGPASSWORD before running the app.

PGHOST=marimo-demo-pg-hevans-demo.h.aivencloud.com
PGPORT=20219
PGDATABASE=defaultdb
PGUSER=avnadmin
PGPASSWORD=changeme
PGSSLMODE=require
