# api.py (the small bridge between the WASM notebook and Postgres) reads
# a single DATABASE_URL connection string -- the same shape Aiven injects
# automatically at runtime when a Postgres service integration is attached.
#
# Get the real value from the Aiven Console: Services -> your Postgres
# service -> Overview -> Connection information (or `avn service get
# <service> --project <project> -v` with the CLI).
#
# Copy this file to .env and fill in the password before running api.py
# locally.

DATABASE_URL=postgres://avnadmin:changeme@your-service-project.h.aivencloud.com:12345/defaultdb?sslmode=require
